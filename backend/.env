# backend/.env

# PostgreSQL Database Configuration
# These values should match your local or production PostgreSQL setup
POSTGRES_DB=healthcare_db
POSTGRES_USER=healthcare_user
POSTGRES_PASSWORD=healthcare_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django Configuration
# Generate a new, random secret key for production environments
DJANGO_SECRET_KEY=django_secret_key
DJANGO_DEBUG=True
# For production, change DJANGO_DEBUG to False and list your domain/IP here
# Example: DJANGO_ALLOWED_HOSTS=your_domain.com,13.234.185.35
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT Configuration
# Use a long, random, and secret string for the signing key
JWT_SIGNING_KEY=jwt-signing-key
